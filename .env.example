# Copy to .env (repo root) and fill in. Everything except the key has a default.
# Without OPENAI_API_KEY the app runs in offline mock mode (scripted agent, no voice).

OPENAI_API_KEY=

# auto | openai | mock   (auto = openai when a key is present)
LLM_PROVIDER=auto

# Models
CHAT_MODEL=gpt-4.1-mini
VERIFIER_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
REALTIME_MODEL=gpt-realtime-mini
REALTIME_VOICE=marin
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Vector store: empty = embedded Qdrant (in-process). Set to use a Qdrant server / Qdrant Cloud.
QDRANT_URL=
QDRANT_API_KEY=

# Retrieval confidence thresholds (defaults are calibrated per embedding model; see scripts/calibrate.py)
# ESCALATE_THRESHOLD=0.30
# ANSWER_THRESHOLD=0.42

# Resilience and abuse protection
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2
TOOL_TIMEOUT_S=4
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_VOICE_SESSIONS_PER_10MIN=6
VOICE_MAX_SESSION_S=300

# Local dev only (Vite on :5173 calling the API on :8000)
CORS_ORIGINS=http://localhost:5173
